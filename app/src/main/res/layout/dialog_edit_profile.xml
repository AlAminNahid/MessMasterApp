<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <androidx.cardview.widget.CardView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="29dp"
        app:cardElevation="3dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="Edit profile"
            android:src="@drawable/profile_icon"
            app:tint="@color/text_strong" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text="Edit Profile"
        android:textColor="@color/text_strong"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="22dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:text="Update your manager details for this mess account."
        android:textColor="@color/text_muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Name"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputEditProfileName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_manager"
        android:hint="Enter your name"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_strong"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Phone number"
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputEditProfilePhone"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_input_manager"
        android:hint="Enter your phone number"
        android:inputType="phone"
        android:paddingHorizontal="16dp"
        android:singleLine="true"
        android:textColor="@color/text_strong"
        android:textColorHint="@color/text_faint"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelEditProfile"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/white"
            android:text="Cancel"
            android:textColor="@color/text_strong"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnSaveEditProfile"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/black"
            android:text="Save"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>
