<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".memberdashboard.MemberNoticeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="34dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTICES &amp;"
                android:textColor="@color/label_on_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Messages"
                android:textColor="@color/white"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_white_card"
            android:elevation="6dp"
            android:padding="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEND TO MANAGER"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTypeMealReport"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_join_button"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:stateListAnimator="@null"
                    android:text="Meal report"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTypeBazarRequest"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_outline"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:stateListAnimator="@null"
                    android:text="Bazar request"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTypeOffMeal"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_button_outline"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:stateListAnimator="@null"
                    android:text="Off meal"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTypeOther"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_button_outline"
                    android:backgroundTint="@null"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="0dp"
                    android:stateListAnimator="@null"
                    android:text="Other"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <EditText
                android:id="@+id/inputNoticeMessage"
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_manager"
                android:gravity="top|start"
                android:hint="e.g., Today I had 2 meals - please count both lunch and dinner..."
                android:inputType="textMultiLine"
                android:minLines="4"
                android:padding="16dp"
                android:textColor="@color/black"
                android:textColorHint="@color/text_secondary" />

            <Button
                android:id="@+id/btnSendToManager"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/black"
                android:text="Send to manager"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="FROM MANAGER"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/layoutNoticesFromManager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:background="@drawable/bg_white_card"
            android:elevation="6dp"
            android:padding="18dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="MY SENT NOTICES"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/layoutMySentNotices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:background="@drawable/bg_white_card"
            android:elevation="6dp"
            android:padding="18dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
