<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_dialog_rounded">

    <androidx.cardview.widget.CardView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="center_horizontal"
        app:cardCornerRadius="29dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/mail_icon"
            android:contentDescription="Invite member" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Invite Member"
        android:textColor="@color/text_strong"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the email of the person you want to invite to this mess."
        android:textColor="@color/text_muted"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginBottom="20dp" />

    <EditText
        android:id="@+id/inputInviteEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_input_manager"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:hint="Enter member email"
        android:textColor="@color/black"
        android:textColorHint="@color/text_secondary"
        android:inputType="textEmailAddress"
        android:singleLine="true"/>

    <Button
        android:id="@+id/btnFindUser"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:text="Find"
        android:textColor="@color/text_strong"
        android:textSize="15sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:strokeColor="@color/surface_border"
        app:strokeWidth="1dp"
        android:backgroundTint="@color/white" />

    <LinearLayout
        android:id="@+id/layoutInviteResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_input_manager"
        android:padding="14dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/txtInviteResultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Jane Doe"/>

        <TextView
            android:id="@+id/txtInviteResultEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            tools:text="jane@gmail.com"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutInviteActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:visibility="gone">

        <Button
            android:id="@+id/btnCancelInvite"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_strong"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:strokeColor="@color/surface_border"
            app:strokeWidth="1dp"
            android:backgroundTint="@color/white"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/btnAddInvite"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Add"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:backgroundTint="@color/black"
            android:layout_marginStart="10dp" />

    </LinearLayout>

</LinearLayout>
