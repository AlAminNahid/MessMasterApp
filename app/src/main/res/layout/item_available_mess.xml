<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/messItemRoot"
    android:layout_width="match_parent"
    android:layout_height="106dp"
    android:layout_marginBottom="18dp"
    android:background="@drawable/bg_mess_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/messNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mess name"
            android:textColor="#111111"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/messAddressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mess address"
            android:textColor="#8A8A8A"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <Button
        android:id="@+id/joinMessButton"
        android:layout_width="102dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_join_button"
        app:backgroundTint="@null"
        android:text="Join"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>