<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:context=".managerdashboard.FragmentUtility">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black"
            android:orientation="vertical"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:paddingTop="34dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MANAGER"
                        android:textColor="@color/label_on_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Utility Bills"
                        android:textColor="@color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginHorizontal="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="72dp"
                android:background="@drawable/bg_dark_card"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL UTILITY COST"
                    android:textColor="@color/label_on_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtTotalUtilityCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="72dp"
                android:background="@drawable/bg_dark_card"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PER PERSON"
                    android:textColor="@color/label_on_dark"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtUtilityPerPerson"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/white"
                    android:textSize="19sp"
                    android:textStyle="bold"/>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/bg_white_card"
            android:elevation="6dp"
            android:padding="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADD UTILITY BILL"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ELECTRICITY"
                        android:textStyle="bold"
                        android:textColor="@color/label_muted"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/inputElectricityAmount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_manager"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/black"
                        android:hint="Electricity (৳)"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INTERNET"
                        android:textStyle="bold"
                        android:textColor="@color/label_muted"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/inputInternetAmount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_manager"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/black"
                        android:hint="Internet (৳)"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GAS"
                        android:textStyle="bold"
                        android:textColor="@color/label_muted"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/inputGasAmount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_manager"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/black"
                        android:hint="Gas (৳)"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAID"
                        android:textStyle="bold"
                        android:textColor="@color/label_muted"
                        android:textSize="14sp"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/inputMaidAmount"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_input_manager"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/black"
                        android:hint="Maid (৳)"
                        android:textColorHint="@color/text_secondary"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTH"
                    android:textStyle="bold"
                    android:textColor="@color/label_muted"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp"/>

                <EditText
                    android:id="@+id/inputUtilityMonth"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_input_manager"
                    android:clickable="true"
                    android:focusable="false"
                    android:textColor="@color/black"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:hint="Month"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="date"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnAddUtility"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/black"
                android:text="SAVE UTILITY ENTRY"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:text="CURRENT MONTH BILLS"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:background="@drawable/bg_white_card"
            android:elevation="6dp"
            android:padding="18dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Electricity"
                    android:textColor="@color/label_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtElectricityBill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Internet"
                    android:textColor="@color/label_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtInternetBill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Gas"
                    android:textColor="@color/label_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtGasBill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Maid"
                    android:textColor="@color/label_on_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/txtMaidBill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ ..."
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnEditCurrentUtility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_margin="18dp"
            android:backgroundTint="@color/black"
            android:text="EDIT CURRENT MONTH UTILITY"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
