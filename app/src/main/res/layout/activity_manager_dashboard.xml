<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/managerFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_manager_dashboard"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/managerBottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        app:itemIconTint="@color/manager_bottom_nav_color"
        app:itemTextColor="@color/manager_bottom_nav_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_manager_bottom_nav" />

</LinearLayout>