<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ManagerSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#777777</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="ManagerInfoCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_white_card</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ManagerActionCard" parent="ManagerInfoCard">
        <item name="android:layout_height">116dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="ManagerFormCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">24dp</item>
        <item name="android:background">@drawable/bg_white_card</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="ManagerInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_input_manager</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textColorHint">#777777</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ManagerPrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:backgroundTint">#000000</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ManagerSecondaryButton" parent="ManagerPrimaryButton">
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#111111</item>
    </style>

    <style name="ManagerDangerButton" parent="ManagerPrimaryButton">
        <item name="android:backgroundTint">#FFFFFF</item>
        <item name="android:textColor">#B80000</item>
    </style>

    <style name="ManagerListCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_white_card</item>
        <item name="android:lineSpacingExtra">8dp</item>
        <item name="android:padding">18dp</item>
        <item name="android:textColor">#111111</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ManagerBlackSummary">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>