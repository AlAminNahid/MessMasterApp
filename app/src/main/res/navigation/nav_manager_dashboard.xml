<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_manager_dashboard"
    app:startDestination="@id/homeFragment">
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.bilimbistudio.messmaster.managerdashboard.FragmentHome"
        android:label="Home">

        <action
            android:id="@+id/action_profileFragment_to_mealsFragment"
            app:destination="@+id/mealsFragment"/>

        <action
            android:id="@+id/action_profileFragment_to_utilityFragment"
            app:destination="@+id/utilityFragment"/>

        <action
            android:id="@+id/action_profileFragment_to_noticeFragment"
            app:destination="@id/noticeFragment" />

    </fragment>

    <fragment
        android:id="@+id/mealsFragment"
        android:name="com.bilimbistudio.messmaster.managerdashboard.FragmentMeal"
        android:label="Meals" />

    <fragment
        android:id="@+id/utilityFragment"
        android:name="com.bilimbistudio.messmaster.managerdashboard.FragmentUtility"
        android:label="Utility" />

    <fragment
        android:id="@+id/noticeFragment"
        android:name="com.bilimbistudio.messmaster.managerdashboard.FragmentNotice"
        android:label="Notice" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.bilimbistudio.messmaster.managerdashboard.FragmentProfile"
        android:label="Profile"/>

</navigation>